extends RefCounted
# Assembles buildings from glTF parts that are listed in res://data/parts.csv.
# The size of every part is measured from its meshes, so the origin of a model does not matter.
# Each part is placed by its bottom centre. "facing" (+z or -z) is the model side that looks outwards.
#
# build_house:  rectangular building (walls, door, windows, gable roof, gables)
# build_church: cross-shaped plan from a 3 x 3 grid (corners empty), tower = arm on the door side
#
# Wall:  pieces of the "wall" template are repeated along each side; they are stretched or
#        compressed slightly so that the wall length is met exactly (FIT_WALL_LENGTH).
# Roof:  gable roof, ridge along the longer side (square: perpendicular to the door wall).

const PARTS_DIR := "res://models/parts/"
const OVERHANG_ACROSS := 0.5     # roof overhang at the eaves (metres)
const OVERHANG_ALONG := 0.7      # roof overhang at the gables (beams stick out there)
const TOWER_ROOF_SINK := 0.2     # tower roof starts this far below the top of the tower walls
const FIT_WALL_LENGTH := true    # true: stretch/compress pieces to the exact wall length
const FLOOR_Y := 0.03            # height of the path tiles above the meadow

# Imported glTF materials are often metallic. Without reflections (we have no sky or probe)
# metallic surfaces look black with white highlights. This switches the metal off.
const NEUTRALIZE_METAL := true
const DEBUG_MATERIALS := true    # print the material data of every part to the console

var parts := {}                  # role -> {"scene", "aabb", "facing", "ridge"}
var messages: Array = []


func is_ready() -> bool:
	return parts.has("wall") and parts.has("wall_door")


func load_parts(csv_path: String) -> void:
	parts.clear()
	messages.clear()
	var f := FileAccess.open(csv_path, FileAccess.READ)
	if f == null:
		messages.append("parts.csv not found: " + csv_path)
		return
	var header := f.get_csv_line(";")
	var i_role := header.find("role")
	var i_file := header.find("file")
	var i_facing := header.find("facing")
	var i_ridge := header.find("ridge_axis")
	var i_yaw := header.find("yaw_deg")
	if i_role < 0 or i_file < 0:
		messages.append("parts.csv needs the columns role and file")
		return
	while not f.eof_reached():
		var row := f.get_csv_line(";")
		if row.size() <= maxi(i_role, i_file):
			continue
		var role := row[i_role].strip_edges()
		if role == "" or role.begins_with("#"):
			continue
		var path := PARTS_DIR + row[i_file].strip_edges()
		if not ResourceLoader.exists(path):
			messages.append("Part '%s' missing or not imported yet: %s" % [role, path])
			continue
		var scene = load(path)
		if not (scene is PackedScene):
			messages.append("Part '%s' is not a scene: %s" % [role, path])
			continue
		var probe := (scene as PackedScene).instantiate() as Node3D
		if probe == null:
			continue
		var boxes: Array = []
		_collect(probe, Transform3D.IDENTITY, boxes)
		_fix_materials(probe, role)
		probe.free()
		parts[role] = {"scene": scene, "aabb": _merge(boxes),
			"facing": _cell(row, i_facing, "+z"), "ridge": _cell(row, i_ridge, "z"), "yaw": float(_cell(row, i_yaw, "0"))}


func _cell(row: PackedStringArray, index: int, fallback: String) -> String:
	if index < 0 or index >= row.size():
		return fallback
	var v := row[index].strip_edges()
	return v if v != "" else fallback


func _collect(node: Node, parent_xf: Transform3D, boxes: Array) -> void:
	var xf := parent_xf
	if node is Node3D:
		xf = parent_xf * (node as Node3D).transform
	if node is MeshInstance3D:
		var mesh := (node as MeshInstance3D).mesh
		if mesh != null:
			boxes.append(xf * mesh.get_aabb())
	for child in node.get_children():
		_collect(child, xf, boxes)


# Materials are resources shared by all instances of a part, so this runs once per part.
func _fix_materials(node: Node, role: String) -> void:
	if node is MeshInstance3D:
		var mesh := (node as MeshInstance3D).mesh
		if mesh != null:
			for s in mesh.get_surface_count():
				var m := mesh.surface_get_material(s)
				if m is BaseMaterial3D:
					var bm := m as BaseMaterial3D
					if DEBUG_MATERIALS:
						var tex := "none"
						if bm.albedo_texture != null:
							tex = bm.albedo_texture.resource_path
						print("[parts] %s surface %d: albedo=%s color=%s texture=%s metallic=%.2f roughness=%.2f metal_tex=%s vertex_color=%s" % [
							role, s, str(bm.albedo_color), "", tex, bm.metallic, bm.roughness,
							str(bm.metallic_texture != null), str(bm.vertex_color_use_as_albedo)])
					if NEUTRALIZE_METAL:
						bm.metallic = 0.0
						bm.metallic_texture = null
						bm.roughness = 0.9
						bm.roughness_texture = null
						bm.metallic_specular = 0.2
				elif DEBUG_MATERIALS:
					print("[parts] %s surface %d: no BaseMaterial3D (%s)" % [role, s, str(m)])
	for child in node.get_children():
		_fix_materials(child, role)


func _merge(boxes: Array) -> AABB:
	if boxes.is_empty():
		return AABB()
	var result: AABB = boxes[0]
	for i in range(1, boxes.size()):
		result = result.merge(boxes[i])
	return result


func _first_mesh(node: Node, parent_xf: Transform3D) -> Array:
	var xf := parent_xf
	if node is Node3D:
		xf = parent_xf * (node as Node3D).transform
	if node is MeshInstance3D and (node as MeshInstance3D).mesh != null:
		return [(node as MeshInstance3D).mesh, xf]
	for child in node.get_children():
		var found := _first_mesh(child, xf)
		if not found.is_empty():
			return found
	return []


# Place a part so that the bottom centre of its bounding box lands on cb (relative to parent).
func _place(parent: Node3D, role: String, cb: Vector3, rot_deg: float, scale: Vector3) -> void:
	if not parts.has(role):
		return
	var part: Dictionary = parts[role]
	var box: AABB = part["aabb"]
	var inst := (part["scene"] as PackedScene).instantiate() as Node3D
	if inst == null:
		return
	var holder := Node3D.new()
	holder.add_child(inst)
	holder.basis = Basis(Vector3.UP, deg_to_rad(rot_deg + float(part.get("yaw", 0.0)))) * Basis.IDENTITY.scaled(scale)
	var native_cb := Vector3(box.get_center().x, box.position.y, box.get_center().z)
	holder.position = cb - holder.basis * native_cb
	parent.add_child(holder)


func _side_rotation(side: String, role: String) -> float:
	var base := 0.0
	match side:
		"N":
			base = 180.0
		"E":
			base = 90.0
		"W":
			base = -90.0
	if parts.has(role) and String(parts[role]["facing"]) == "-z":
		base += 180.0
	return base


func _wall_point(side: String, t: float, lx: float, lz: float, thick: float) -> Vector3:
	match side:
		"N":
			return Vector3(t, 0.0, -lz / 2.0 + thick / 2.0)
		"S":
			return Vector3(t, 0.0, lz / 2.0 - thick / 2.0)
		"E":
			return Vector3(lx / 2.0 - thick / 2.0, 0.0, t)
	return Vector3(-lx / 2.0 + thick / 2.0, 0.0, t)


func _window_role(floor_index: int) -> String:
	var window := "wall_window_wide" if floor_index == 0 else "wall_window_thin"
	if not parts.has(window):
		window = "wall_window_thin" if parts.has("wall_window_thin") else "wall"
	return window


# Door in the middle of the door wall (ground floor); windows on every second piece, mirrored,
# never at the corners and never next to the door. Ground floor: wide windows, upper floors: thin.
func _wall_role(is_door_wall: bool, i: int, n: int, floor_index: int) -> String:
	var middle := int(n / 2)
	var window := _window_role(floor_index)
	if is_door_wall and i == middle:
		if floor_index == 0:
			return "wall_door"
		return window
	var mirrored := mini(i, n - 1 - i)
	if mirrored == 0:
		return "wall"
	if is_door_wall and abs(i - middle) <= 1:
		return "wall"
	if mirrored % 2 == 1:
		return window
	return "wall"


func _ridge_axis(lx: float, lz: float, door_side: String) -> String:
	if lx > lz + 0.01:
		return "x"
	if lz > lx + 0.01:
		return "z"
	return "z" if (door_side == "N" or door_side == "S") else "x"


# Gable roof centred on c (x, z). span = width across the ridge (without overhang),
# ridge_len = length along the ridge including overhangs. Returns tan(pitch).
func _add_roof(root: Node3D, c: Vector2, ridge_world: String, span: float, ridge_len: float, wall_top: float) -> float:
	var roof: Dictionary = parts["roof"]
	var rbox: AABB = roof["aabb"]
	var ridge_native := String(roof["ridge"])
	var span_native := rbox.size.x if ridge_native == "z" else rbox.size.z
	var len_native := rbox.size.z if ridge_native == "z" else rbox.size.x
	var tan_pitch := rbox.size.y / (span_native / 2.0)
	var across := (span + 2.0 * OVERHANG_ACROSS) / span_native
	var along := ridge_len / len_native
	var roof_scale := Vector3(across, across, along) if ridge_native == "z" else Vector3(along, across, across)
	var roof_rot := 0.0 if ridge_native == ridge_world else 90.0
	_place(root, "roof", Vector3(c.x, wall_top - OVERHANG_ACROSS * tan_pitch, c.y), roof_rot, roof_scale)
	return tan_pitch


# Triangular gable piece standing on the wall top; pos = centre of the wall.
func _add_gable(root: Node3D, side: String, pos: Vector3, span: float, tan_pitch: float, wall_top: float) -> void:
	var role := "gable_large"
	if not parts.has("gable_large") or (span < 5.0 and parts.has("gable_small")):
		role = "gable_small"
	if not parts.has(role):
		return
	var gbox: AABB = parts[role]["aabb"]
	var g_scale := Vector3(span / gbox.size.x, (span / 2.0 * tan_pitch) / gbox.size.y, 1.0)
	pos.y = wall_top
	_place(root, role, pos, _side_rotation(side, role), g_scale)


# centre: building centre (x, z) in world coordinates.
# Returns {"wall_top": float, "height": float}.
func build_house(parent: Node3D, centre: Vector2, lx: float, lz: float, floors: int, door_side: String) -> Dictionary:
	var wall_box: AABB = parts["wall"]["aabb"]
	var wall_len := wall_box.size.x
	var wall_h := wall_box.size.y
	var thick := wall_box.size.z
	var root := Node3D.new()
	root.position = Vector3(centre.x, 0.0, centre.y)
	parent.add_child(root)

	for side in ["N", "S", "E", "W"]:
		var length := lx if (side == "N" or side == "S") else lz
		var n := maxi(1, int(ceil(length / wall_len - 0.0001)))
		var piece_len := length / float(n) if FIT_WALL_LENGTH else wall_len
		for floor_index in floors:
			for i in n:
				var role := _wall_role(side == door_side, i, n, floor_index)
				var role_box: AABB = parts[role]["aabb"]
				var t := -length / 2.0 + (i + 0.5) * piece_len
				var pos := _wall_point(side, t, lx, lz, thick)
				pos.y = floor_index * wall_h
				_place(root, role, pos, _side_rotation(side, role), Vector3(piece_len / role_box.size.x, 1.0, 1.0))

	var wall_top := floors * wall_h
	var result := {"wall_top": wall_top, "height": wall_top}
	if not parts.has("roof"):
		return result

	var ridge_world := _ridge_axis(lx, lz, door_side)
	var l_ridge := lx if ridge_world == "x" else lz
	var l_span := lz if ridge_world == "x" else lx
	var tan_pitch := _add_roof(root, Vector2.ZERO, ridge_world, l_span, l_ridge + 2.0 * OVERHANG_ALONG, wall_top)
	result["height"] = wall_top + (l_span / 2.0) * tan_pitch
	var end_sides := ["N", "S"] if ridge_world == "z" else ["E", "W"]
	for side in end_sides:
		_add_gable(root, side, _wall_point(side, 0.0, lx, lz, thick), l_span, tan_pitch, wall_top)
	return result


# ---------------------------------------------------------------------------------------------
# Church: rectangular block (size x size). The door is in the middle of one side; on both sides
# of the door a tower rises out of the corner. Local layout with the door in the south (z+);
# the whole building is rotated to the real door side.
# Body: "floors" storeys (3 = ground floor + 2 upper floors).
# Towers: floors + TOWER_EXTRA_FLOORS storeys, CHURCH_TOWER_PIECES wall pieces wide.
# Each side has CHURCH_PIECES pieces: tower, centre part (door), tower.
# ---------------------------------------------------------------------------------------------
const TOWER_EXTRA_FLOORS := 3
const CHURCH_PIECES := 7
const CHURCH_TOWER_PIECES := 2
const CHURCH_GABLE_INSET := 0.6      # front gable is set back behind the tower faces (metres)


func _place_wall(root: Node3D, role: String, pos: Vector3, side: String, piece_len: float) -> void:
	var role_box: AABB = parts[role]["aabb"]
	_place(root, role, pos, _side_rotation(side, role), Vector3(piece_len / role_box.size.x, 1.0, 1.0))


func build_church(parent: Node3D, centre: Vector2, size: float, floors: int, door_side: String) -> Dictionary:
	var wall_box: AABB = parts["wall"]["aabb"]
	var wall_h := wall_box.size.y
	var thick := wall_box.size.z
	var body_floors := maxi(1, floors)
	var tower_floors := body_floors + TOWER_EXTRA_FLOORS
	var body_top := body_floors * wall_h
	var tower_top := tower_floors * wall_h
	var n := CHURCH_PIECES
	var piece_len := size / float(n)
	var tw := CHURCH_TOWER_PIECES * piece_len
	var half := size / 2.0

	var door_rot := 0.0
	match door_side:
		"N":
			door_rot = 180.0
		"E":
			door_rot = 90.0
		"W":
			door_rot = -90.0
	var root := Node3D.new()
	root.position = Vector3(centre.x, 0.0, centre.y)
	root.rotation_degrees = Vector3(0.0, door_rot, 0.0)
	parent.add_child(root)

	# outer walls: towers go up to tower_floors, the rest to body_floors
	for side in ["N", "S", "E", "W"]:
		for i in n:
			var in_tower := false
			if side == "S":
				in_tower = i < CHURCH_TOWER_PIECES or i >= n - CHURCH_TOWER_PIECES
			elif side == "E" or side == "W":
				in_tower = i >= n - CHURCH_TOWER_PIECES
			var storeys := tower_floors if in_tower else body_floors
			var t := -half + (i + 0.5) * piece_len
			for floor_index in storeys:
				var role := _wall_role(side == "S", i, n, floor_index)
				var pos := _wall_point(side, t, size, size, thick)
				pos.y = floor_index * wall_h
				_place_wall(root, role, pos, side, piece_len)

	# inner faces and back faces of the towers above the body
	for sx in [-1.0, 1.0]:
		var inner_side := "E" if sx < 0.0 else "W"
		for floor_index in range(body_floors, tower_floors):
			for k in CHURCH_TOWER_PIECES:
				var along := (k + 0.5) * piece_len
				var inner := Vector3(sx * (half - tw + thick / 2.0), floor_index * wall_h, half - tw + along)
				_place_wall(root, "wall", inner, inner_side, piece_len)
				var back := Vector3(sx * (half - along), floor_index * wall_h, half - tw + thick / 2.0)
				_place_wall(root, "wall", back, "N", piece_len)

	var height := tower_top
	if parts.has("roof"):
		var tan_pitch := _add_roof(root, Vector2(0.0, -OVERHANG_ALONG / 2.0), "z", size, size + OVERHANG_ALONG, body_top)
		_add_gable(root, "N", _wall_point("N", 0.0, size, size, thick), size, tan_pitch, body_top)
		var front := _wall_point("S", 0.0, size, size, thick)
		front.z -= CHURCH_GABLE_INSET
		_add_gable(root, "S", front, size, tan_pitch, body_top)
	if parts.has("roof_tower"):
		var tb: AABB = parts["roof_tower"]["aabb"]
		var sxs := (tw + 2.0 * OVERHANG_ACROSS) / tb.size.x
		var szs := (tw + 2.0 * OVERHANG_ACROSS) / tb.size.z
		var sys := (sxs + szs) / 2.0
		for side_x in [-1.0, 1.0]:
			var tower_centre := Vector3(side_x * (half - tw / 2.0), tower_top - TOWER_ROOF_SINK, half - tw / 2.0)
			_place(root, "roof_tower", tower_centre, 0.0, Vector3(sxs, sys, szs))
		height = tower_top - TOWER_ROOF_SINK + tb.size.y * sys

	var colliders: Array = [{"size": Vector3(size, tower_top, size),
		"pos": Vector3(centre.x, tower_top / 2.0, centre.y)}]
	return {"wall_top": body_top, "height": height, "colliders": colliders}


# ---------------------------------------------------------------------------------------------
# Market square and well
# Market: one corner piece in each corner of the building area (the rest stays open path).
#   The corner model is a corner with arms to the east and south (seen from above, north up);
#   it is turned by 0 / -90 / 180 / 90 degrees for NW / NE / SE / SW.
# Well: four U-shaped stair pieces (open to the west in the model) on the four sides of the
#   centre, each turned so that its opening faces the centre; optional water disc in the middle.
# If a model is rotated wrongly, correct it with the column yaw_deg in parts.csv.
# ---------------------------------------------------------------------------------------------
const WELL_WATER := true
const WELL_WATER_RADIUS := 0.8
const WELL_WATER_COLOR := Color(0.25, 0.5, 0.8)


func has_role(role: String) -> bool:
	return parts.has(role)


func can_build(key: String) -> bool:
	if key == "market":
		return parts.has("market_corner")
	if key == "well":
		return parts.has("well_stairs")
	return is_ready()


# Market and well stand on path tiles (the fields are not blocked for the floor).
func leaves_floor_open(key: String) -> bool:
	return (key == "market" and parts.has("market_corner")) or (key == "well" and parts.has("well_stairs"))


func build_building(key: String, parent: Node3D, centre: Vector2, lx: float, lz: float, floors: int, door_side: String) -> Dictionary:
	if key == "church":
		return build_church(parent, centre, lx, floors, door_side)
	if key == "market":
		return build_market(parent, centre, lx, lz)
	if key == "well":
		return build_well(parent, centre, lx, lz)
	return build_house(parent, centre, lx, lz, floors, door_side)


func build_market(parent: Node3D, centre: Vector2, lx: float, lz: float) -> Dictionary:
	var box: AABB = parts["market_corner"]["aabb"]
	var corners := [[-1.0, -1.0, 0.0], [1.0, -1.0, -90.0], [1.0, 1.0, 180.0], [-1.0, 1.0, 90.0]]
	var colliders: Array = []
	for c in corners:
		var dx: float = c[0] * (lx / 2.0 - box.size.x / 2.0)
		var dz: float = c[1] * (lz / 2.0 - box.size.z / 2.0)
		var rot: float = c[2]
		_place(parent, "market_corner", Vector3(centre.x + dx, 0.0, centre.y + dz), rot, Vector3.ONE)
		colliders.append({"size": box.size, "pos": Vector3(centre.x + dx, box.size.y / 2.0, centre.y + dz)})
	return {"wall_top": 0.0, "height": 0.0, "colliders": colliders}


func build_well(parent: Node3D, centre: Vector2, lx: float, lz: float) -> Dictionary:
	var box: AABB = parts["well_stairs"]["aabb"]
	var yaw := float(parts["well_stairs"].get("yaw", 0.0))
	# The model's native opening is along Z, not X.
	var correction := -90.0
	var angle := deg_to_rad(correction + yaw)
	var extent_x := absf(cos(angle)) * box.size.x + absf(sin(angle)) * box.size.z
	var extent_z := absf(sin(angle)) * box.size.x + absf(cos(angle)) * box.size.z
	var offset := extent_x / 2.0
	var colliders: Array = []
	for sign_x in [-1.0, 1.0]:
		var turn := correction if sign_x > 0.0 else correction + 180.0
		var pos := Vector3(centre.x + sign_x * offset, 0.0, centre.y)
		_place(parent, "well_stairs", pos, turn, Vector3.ONE)
		colliders.append({"size": Vector3(extent_x, box.size.y, extent_z),
			"pos": pos + Vector3(0.0, box.size.y / 2.0, 0.0)})
	if WELL_WATER:
		var water := MeshInstance3D.new()
		var mesh := BoxMesh.new()
		# Water extends underneath the stone rim, hiding the exact seam.
		mesh.size = Vector3(2.0 * extent_x - 0.2, 0.06, extent_z - 0.2)
		var mat := StandardMaterial3D.new()
		mat.albedo_color = WELL_WATER_COLOR
		mesh.material = mat
		water.mesh = mesh
		water.position = Vector3(centre.x, box.size.y * 0.45, centre.y)
		parent.add_child(water)
	# Floating tower roof above the well; no support elements.
	var well_total_height := box.size.y
	if parts.has("roof_tower"):
		var roof_box: AABB = parts["roof_tower"]["aabb"]
		if roof_box.size.x > 0.01 and roof_box.size.y > 0.01 and roof_box.size.z > 0.01:
			var roof_width := 2.0 * extent_x + 0.6
			var roof_depth := extent_z + 0.6
			var roof_sx := roof_width / roof_box.size.x
			var roof_sz := roof_depth / roof_box.size.z
			var roof_sy := minf(roof_sx, roof_sz)
			var roof_bottom := maxf(2.6, box.size.y + 1.6)
			_place(parent, "roof_tower", Vector3(centre.x, roof_bottom, centre.y), 0.0,
				Vector3(roof_sx, roof_sy, roof_sz))
			well_total_height = roof_bottom + roof_box.size.y * roof_sy
	else:
		push_warning("Brunnendach fehlt: Rolle roof_tower konnte nicht geladen werden.")
	return {"wall_top": box.size.y, "height": well_total_height, "colliders": colliders,
		"wall_label_width": 2.0 * extent_x}


func build_floor(parent: Node3D, columns: int, rows: int, cell: float, occupied: Dictionary) -> bool:
	if not parts.has("floor"):
		return false
	var part: Dictionary = parts["floor"]
	var box: AABB = part["aabb"]
	if box.size.x <= 0.01 or box.size.z <= 0.01:
		return false
	var probe := (part["scene"] as PackedScene).instantiate() as Node3D
	var found := _first_mesh(probe, Transform3D.IDENTITY)
	probe.free()
	if found.is_empty():
		return false
	var mesh: Mesh = found[0]
	var mesh_xf: Transform3D = found[1]

	var per_side := maxi(1, int(round(cell / box.size.x)))
	var tile := cell / float(per_side)
	var basis := Basis.IDENTITY.scaled(Vector3(tile / box.size.x, 1.0, tile / box.size.z))
	var native_top := Vector3(box.get_center().x, box.position.y + box.size.y, box.get_center().z)
	var transforms: Array = []
	for c in columns:
		for r in rows:
			if occupied.has(Vector2i(c, r)):
				continue
			for ix in per_side:
				for iz in per_side:
					var centre := Vector3(c * cell + (ix + 0.5) * tile, FLOOR_Y, r * cell + (iz + 0.5) * tile)
					transforms.append(Transform3D(basis, centre - basis * native_top) * mesh_xf)
	if transforms.is_empty():
		return true
	var mm := MultiMesh.new()
	mm.transform_format = MultiMesh.TRANSFORM_3D
	mm.mesh = mesh
	mm.instance_count = transforms.size()
	for i in transforms.size():
		mm.set_instance_transform(i, transforms[i])
	var mmi := MultiMeshInstance3D.new()
	mmi.multimesh = mm
	parent.add_child(mmi)
	return true
